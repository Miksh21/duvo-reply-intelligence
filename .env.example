# ---- Real APIs (these actually run; the Loom shows them working) ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EXA_API_KEY=...

# ---- Going live: real HubSpot (free tier) + lemlist (trial). Leave unset to use mocks. ----
# HUBSPOT_ACCESS_TOKEN=pat-...   # Private App token; then run once: npm run setup:hubspot
# LEMLIST_API_KEY=...

# ---- Optional: real Slack. If unset, cards pretty-print to console AND land in out/slack-cards/*.json ----
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- Models (overridable; defaults are sensible) ----
# OpenAI does high-volume triage + extraction (cheap, fast, JSON mode).
OPENAI_MODEL=gpt-4o-mini
# Anthropic does everything a human/prospect reads (reply copy, Exa queries, brief).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Which provider runs triage: "openai" (default — the documented split) or
# "anthropic" to run the entire pipeline on Claude (e.g. if you have no OpenAI key).
TRIAGE_PROVIDER=openai

# ---- Sender identity (whose voice the reply is drafted in) ----
SENDER_NAME=Tomáš Beneš
SENDER_TITLE=Co-founder
SENDER_COMPANY=Duvo

# ---- Behavior ----
PORT=3000
# Trigger B fires for meetings starting within this many hours (the "morning-of" window).
BRIEF_LEAD_HOURS=18
