# dependencies
node_modules/

# secrets — never commit
.env
.env.*
!.env.example
*.key
credentials.json

# os / editor
.DS_Store
*.log
.idea/
.vscode/

# build output
dist/

# Demo output: Slack cards (fallback mode) and HubSpot state snapshots land here.
# out/* rather than out/, so the directory itself stays tracked via .gitkeep.
out/*
!out/.gitkeep
!out/slack-cards/
out/slack-cards/*
!out/slack-cards/.gitkeep
